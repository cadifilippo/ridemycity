# Firebase test user credentials (email/password auth must be enabled in Firebase console)
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=your-test-password

# Firebase project config
# Optional if apps/web/.env already defines VITE_FIREBASE_API_KEY
FIREBASE_API_KEY=your-firebase-api-key

# App URLs (defaults match local dev)
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# Optional: reuse servers already running on configured ports (disabled by default)
PW_REUSE_SERVER=false
